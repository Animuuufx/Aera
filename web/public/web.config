<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Serve Flash client/map/item SWFs directly through IIS.
         remove+add avoids IIS 500.19 duplicate MIME-map errors when the
         server already has a global .swf MIME mapping. -->
    <staticContent>
      <remove fileExtension=".swf" />
      <mimeMap fileExtension=".swf" mimeType="application/x-shockwave-flash" />
    </staticContent>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- Keep PHP/framework error responses instead of replacing them with IIS HTML errors. -->
    <httpErrors existingResponse="PassThrough" />

    <rewrite>
      <rules>
        <!-- The database can store only a SWF basename while the real asset
             lives in a nested gamefiles directory. Send all wiki-style SWF
             requests through the PHP resolver, which finds the exact asset. -->
        <rule name="Aera - Wiki SWF Resolver" stopProcessing="true">
          <match url="^gamefiles/(.*\.swf)$" />
          <action type="Rewrite" url="wiki/swf?file={R:1}" appendQueryString="false" />
        </rule>

        <!-- Do not route real files or directories through PHP. -->
        <rule name="Aera - Existing File Or Directory" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Everything else is handled by the Aera Foundation front controller. -->
        <rule name="Aera Foundation Front Controller" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Allow uploads up to 80 MB through IIS. The application still limits SWFs to 64 MB. -->
        <requestLimits maxAllowedContentLength="83886080" />
        <hiddenSegments>
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
