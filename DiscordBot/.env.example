DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs used by the bot.
# Moderators can use kick, ban, unban, timeout and clear.
# Administrators can also use announce, botstatus and emulator controls.
DISCORD_MOD_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aera
DB_USER=
DB_PASSWORD=

BOT_STATUS_PORT=5592

# Optional: absolute path to Emulator/PHP/runtime/control when the Discord bot
# is installed separately from the Aera repository. Leave blank when using
# the repository's default Emulator/PHP/runtime/control path.
EMULATOR_CONTROL_ROOT=
